# ─── Database (PostgreSQL) ────────────────────────────────────────────────
# When unset, the app serves bundled seed data so every page still renders.
# Set this + run `npm run prisma:push && npm run seed` to use a real database.
DATABASE_URL="postgresql://user:password@localhost:5432/zerospike?schema=public"

# ─── LLM Curation Engine (multi-provider) ─────────────────────────────────
# Which backend the ingredient evaluator uses: anthropic | openai | none
# `none` (or missing keys) => deterministic rule-based scorer runs offline.
LLM_PROVIDER="anthropic"

# Model id for the selected provider.
#   anthropic: claude-sonnet-5 (default, cost-effective) | claude-opus-5 (max quality)
#   openai:    gpt-4o-mini | gpt-4o | o4-mini, etc.
LLM_MODEL="claude-sonnet-5"

# Provider API keys (only the selected provider's key is needed).
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
# Optional: point the OpenAI-compatible provider at another gateway.
OPENAI_BASE_URL=""

# ─── Affiliate defaults ───────────────────────────────────────────────────
NEXT_PUBLIC_DEFAULT_AMAZON_TAG="zerospike-21"

# ─── Site ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
